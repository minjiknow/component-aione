<!-- Topbar component fragment: 공통 페이지 정보와 화면별 액션을 한 상단바에 구성합니다. -->
<header class="topbar app-topbar">
	<div class="topbar-left">
		<h1 class="topbar-title" data-topbar-title>{{title}}</h1>
		<p class="topbar-sub" data-topbar-subtitle>{{subtitle}}</p>
	</div>

	<div class="topbar-workspace-slot" data-slot="workspace"></div>

	<div class="topbar-right app-topbar-actions">
		<button type="button" class="button button-soft-primary" id="newClassifyBtn" data-pages="{{primaryActionPage}}"
			data-workspace-action="{{primaryActionName}}" aria-label="{{primaryActionLabel}}" title="{{primaryActionLabel}}">
			<img class="icon icon-small" aria-hidden="true" data-icon="plus" alt="" />
			<span>{{primaryActionLabel}}</span>
		</button>
		<button type="button" class="icon-button icon-button-purple" id="runDrawerBtn" data-pages="{{secondaryActionPage}}"
			aria-label="{{secondaryActionLabel}}" title="{{secondaryActionLabel}}">
			<img class="icon icon-primary" aria-hidden="true" data-icon="list" alt="" />
		</button>
		<button type="button" class="icon-button icon-button-purple" id="ruleManageBtn" data-pages="intake" aria-label="룰 설정" title="룰 설정">
			<img class="icon icon-primary" aria-hidden="true" data-icon="edit-compact" alt="" />
		</button>
		<button type="button" class="icon-button icon-button-workspace" id="notificationAssigneeBtn"
			aria-label="실국별 알림 담당자 설정" title="실국별 알림 담당자 설정">
			<img class="icon icon-primary" aria-hidden="true" data-icon="notification-assignee" alt="" />
		</button>

		<div class="accessory-tool" data-accessory-tools data-accessory-swap-target="panelSwapBtn"
			data-accessory-layout-target="layoutResetBtn">
			<button type="button" class="accessory-trigger" aria-label="보조도구 모음" title="보조도구 모음"
				aria-haspopup="true" aria-expanded="false">
				<span class="accessory-icon-closed" aria-hidden="true">
					<svg viewBox="0 0 24 24">
						<rect x="3.5" y="3.5" width="7" height="7" rx="2" />
						<rect x="13.5" y="3.5" width="7" height="7" rx="2" />
						<rect x="3.5" y="13.5" width="7" height="7" rx="2" />
						<path d="M17 14v6M14 17h6" />
					</svg>
				</span>
				<span class="accessory-icon-open" aria-hidden="true">
					<svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" /></svg>
				</span>
			</button>
			<div class="accessory-rail" role="toolbar" aria-label="보조도구 기능">
				<button type="button" class="accessory-action" data-accessory-action="font"
					aria-label="전체 글자크기" title="전체 글자크기" aria-haspopup="dialog" aria-expanded="false">
					<span class="accessory-action-icon">
						<span class="accessory-font-symbol" aria-hidden="true"><small>A</small><strong>A</strong></span>
					</span>
				</button>
				<button type="button" class="accessory-action" data-accessory-action="swap"
					aria-label="패널 위치 변경" title="패널 위치 변경">
					<span class="accessory-action-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24"><path d="M8 7H4m0 0 4 4M4 7l4-4M16 17h4m0 0-4-4m4 4-4 4" /></svg>
					</span>
				</button>
				<button type="button" class="accessory-action" data-accessory-action="layout"
					aria-label="레이아웃 초기화" title="레이아웃 초기화">
					<span class="accessory-action-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24">
							<rect x="3" y="3" width="18" height="18" rx="2" />
							<path d="M9 3v18M15 3v18" />
						</svg>
					</span>
				</button>
				<button type="button" class="accessory-action" data-accessory-action="fullscreen"
					aria-label="전체화면" title="전체화면">
					<span class="accessory-action-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24"><path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5" /></svg>
					</span>
				</button>
			</div>
			<div class="accessory-font-panel hidden" role="dialog" aria-label="전체 글자크기">
				<div class="accessory-font-head"><strong>전체 글자크기</strong><span>100~150%</span></div>
				<div class="accessory-font-control">
					<button type="button" data-accessory-font-decrease aria-label="글자 작게">−</button>
					<span data-accessory-font-value aria-live="polite">100%</span>
					<button type="button" data-accessory-font-increase aria-label="글자 크게">＋</button>
				</div>
				<button type="button" class="accessory-font-default">기본 크기로</button>
			</div>
		</div>

		<button type="button" class="icon-button accessory-source-control" id="panelSwapBtn"
			aria-label="패널 위치 변경" title="패널 위치 변경" hidden>
			<img class="icon icon-primary" aria-hidden="true" data-icon="panel-swap" alt="" />
		</button>
		<button type="button" class="icon-button accessory-source-control" id="layoutResetBtn"
			aria-label="레이아웃 초기화" title="레이아웃 초기화" hidden>
			<img class="icon icon-primary" aria-hidden="true" data-icon="layout-columns" alt="" />
		</button>
		<button type="button" class="icon-button accessory-source-control" id="resetBtn"
			aria-label="초기화" title="초기화" hidden>
			<img class="icon icon-primary" aria-hidden="true" data-icon="reset" alt="" />
		</button>
		<button type="button" class="icon-button accessory-source-control" id="fullscreenBtn"
			aria-label="전체화면" title="전체화면" hidden>
			<img class="fullscreen-expand icon icon-primary" aria-hidden="true" data-icon="fullscreen-expand" alt="" />
			<img class="fullscreen-shrink icon icon-primary hidden" aria-hidden="true"
				data-icon="fullscreen-shrink" alt="" />
		</button>
	</div>
</header>
